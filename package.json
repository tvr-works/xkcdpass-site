{
  "name": "xkcdpass-site",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": "26.13.0",
    "npm": "11.20.0"
  },
  "scripts": {
    "check:runtime": "node scripts/check-runtime.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "validate": "node scripts/validate-site.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run check:runtime && npm run format:check && npm run lint && npm run typecheck && npm run validate && npm test",
    "build": "npm run check:runtime && node scripts/build-site.mjs",
    "preview": "node scripts/serve-site.mjs",
    "test:browser": "playwright test",
    "ci:gate": "node scripts/wait-for-ci.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@shadcn/lint": "0.2.5",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "oxfmt": "0.77.0",
    "oxlint": "1.89.0",
    "parse5": "8.1.1",
    "shadcn": "4.22.1",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "4.3.3"
  }
}
